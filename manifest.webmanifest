{
  "name": "Bâtir Sûr — Construction & sécurité de la maison",
  "short_name": "Bâtir Sûr",
  "description": "Calculateur de matériaux, devis global, journal de chantier et diagnostic de sécurité de la maison.",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f7f2ea",
  "theme_color": "#2a3336",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "/batir-sur/",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities",
    "business"
  ],
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "prefer_related_applications": false,
  "related_applications": [],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "edge_side_panel": {
    "preferred_width": 420
  },
  "shortcuts": [
    {
      "name": "Calculateur",
      "short_name": "Calculs",
      "url": "./#calc",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Devis global",
      "short_name": "Devis",
      "url": "./#devis",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Journal de chantier",
      "short_name": "Journal",
      "url": "./#journal",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Diagnostic maison",
      "short_name": "Diagnostic",
      "url": "./#diag",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ],
        "text/markdown": [
          ".md"
        ],
        "text/csv": [
          ".csv"
        ],
        "application/json": [
          ".json"
        ]
      }
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/calculateur-mobile.png",
      "sizes": "1080x2340",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Calculateur de matériaux"
    },
    {
      "src": "screenshots/devis-mobile.png",
      "sizes": "1080x2340",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Devis global par lot"
    },
    {
      "src": "screenshots/diagnostic-mobile.png",
      "sizes": "1080x2340",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Diagnostic de sécurité de la maison"
    },
    {
      "src": "screenshots/calculateur-pc.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Calculateurs sur ordinateur"
    },
    {
      "src": "screenshots/devis-pc.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Devis global sur ordinateur"
    }
  ]
}